generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  username  String   @unique
  about     String?  @default("Hey there! I'm using Chat App.")
  image     String?
  isOnline  Boolean  @default(false)
  lastSeen  DateTime @default(now())
  isPrivate Boolean  @default(false)

  messages      Message[]
  conversations Conversation[] @relation("UserConversations")

  blockedUsers Block[] @relation("Blocker")
  blockedBy    Block[] @relation("Blocked")

  // Index for searching users by username/email
  @@index([username, email])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages     Message[]
  participants User[]    @relation("UserConversations")

  // Critical for sorting the sidebar by "most recent activity"
  @@index([updatedAt(sort: Desc)])
}

model Message {
  id             String   @id @default(uuid())
  content        String?
  createdAt      DateTime @default(now())
  authorId       String
  conversationId String

  isRead    Boolean @default(false)
  isDeleted Boolean @default(false)

  messageType   MessageType @default(TEXT)
  attachmentUrl String?

  replyToId String?
  replyTo   Message?  @relation("ReplyRelation", fields: [replyToId], references: [id])
  replies   Message[] @relation("ReplyRelation")

  author       User         @relation(fields: [authorId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  // COMPOUND INDEXES (Optimization)
  // 1. Instantly fetch history for a specific chat, ordered by time
  @@index([conversationId, createdAt(sort: Desc)])
  // 2. Instantly count unread messages for a specific user in a specific chat
  @@index([conversationId, isRead])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blockedId String

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  // Speeds up "Am I blocked?" checks
  @@index([blockerId])
  @@index([blockedId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
}
